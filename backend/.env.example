# Pathly Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Security & JWT
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY=pathly-super-secret-jwt-key-change-in-production-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Database Settings
# Set to your MongoDB connection string (e.g. mongodb://localhost:27017 or mongodb+srv://...)
# If local MongoDB is not running, the application gracefully initializes a local mock database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pathly_db
USE_MONGOMOCK_FALLBACK=True

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth (Optional - set when valid Google Client ID/Secret are available)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

